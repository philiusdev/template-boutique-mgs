# ============================================================================
# Exemple de variables d'environnement — Template boutique MGS (Royal Shop)
# ============================================================================
# Ce fichier ne contient que des valeurs FACTICES. Il sert de liste de contrôle :
# copiez-le en `.env.local`, puis remplacez chaque `remplir` par la valeur réelle.
#
# .env.local n'est JAMAIS commité (voir .gitignore). Ne recopiez jamais une clé
# vraie dans ce fichier : il est suivi par git.
#
# Deux familles de variables cohabitent ici :
#   1. la BOUTIQUE (Supabase), qui fait tourner le site lui-même ;
#   2. l'AGENCE MGS (plateforme MindGraphixSolution), qui fournit l'espace
#      « Mon agence ».
# L'absence de la famille 2 n'empêche PAS le site de fonctionner : c'est la règle
# d'or du projet. Le site se rend normalement, l'onglet et le bouton flottant
# disparaissent, rien ne casse.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. BOUTIQUE — Supabase
# ----------------------------------------------------------------------------

# URL du projet Supabase.
# Les deux variables NEXT_PUBLIC_* ci-dessous sont VOLONTAIREMENT publiques :
# Next.js les inline dans le bundle du navigateur, ce qui est sans risque pour la
# clé anonyme, car elle n'accorde que ce que les politiques RLS autorisent.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=remplir

# Cle de service Supabase : contourne la RLS et voit TOUTES les donnees, y
# compris les comptes clients. Serveur uniquement.
# NE DOIT JAMAIS ETRE PREFIXEE PAR `NEXT_PUBLIC_`.
# Si elle l'etait, elle serait inlinee dans le bundle du navigateur : chaque
# visiteur pourrait la lire dans la source de la page, l'extraire, et lire ou
# modifier toute la base — comptes, commandes, preuves de paiement comprises.
SUPABASE_SERVICE_ROLE_KEY=remplir_serveur_uniquement

# Bascule le mode demonstration. `false` seule active le mode reel ; toute autre
# valeur — ou l'absence des identifiants Supabase ci-dessus — laisse le site en
# demonstration, avec des produits et des commandes de test en memoire.
#   true  : donnees de demonstration, aucune base demandee (defaut du modele)
#   false : boutique reelle, lecture et ecriture dans Supabase
NEXT_PUBLIC_DEMO_MODE=true

# En-tete HTTP porteur de l'adresse IP du visiteur, uniquement si un proxy de
# confiance devant l'application la REECRIT (Cloudflare, Traefik, reverse proxy
# interne…). Sinon, laissez la variable VIDE.
# Renseignee a tort, la limitation des tentatives de connexion se contourne
# trivialement : il suffit d'envoyer l'en-tete soi-meme.
TRUSTED_AUTH_RATE_LIMIT_IP_HEADER=


# ----------------------------------------------------------------------------
# 2. AGENCE MGS — plateforme MindGraphixSolution
# ----------------------------------------------------------------------------
# Le site appelle la plateforme en SERVEUR, jamais depuis le navigateur, avec
# deux en-tetes : `X-Site-Key` et `Authorization: Bearer <secret>`.
# La cle et le secret sont delivres par la plateforme pour CE site, et par aucun
# autre chemin : `npm run site:credential` dans le depot plateforme
# (scripts/create-site-credential.mjs). Il n'existe pas d'ecran d'administration
# pour les creer ou les regenerer, et le tableau de bord de la plateforme
# n'affiche ni la cle ni le secret. Le secret n'est conserve que hache en base
# et n'est montre qu'une fois : perdu, il faut regenerer un jeu d'identifiants.
#
# Si l'une des trois premiere variables manque, `callAgency` renvoie `null`
# immediatement : AUCUN appel reseau n'est tente, et le site s'affiche normalement.
# ------------------------------------------------------------------------

# URL de la plateforme, SANS slash final et SANS chemin (/api est ajoute par le
# connecteur). Le protocole doit etre HTTPS... sauf si le nom d'hote est
# litteralement `localhost`.
#
# ATTENTION — `localhost` n'est PAS `127.0.0.1` :
#   - `http://localhost:3001`  -> passe (la connexion est consideree locale)
#   - `http://127.0.0.1:3001`  -> REFUSE, cote site ET cote plateforme.
# Les deux codes comparent le nom d'hote a la chaine `localhost` ; un garde-fou
# SSRF qui accepterait 127.0.0.1 accepterait aussi 0.0.0.0 ou ::1. Un caractere
# de travers suffit a rendre l'agence muette SANS la moindre erreur affichee.
MGS_PLATFORM_URL=https://plateforme.example.com

# Identifiant public du site sur la plateforme. Ce n'est PAS un secret : il
# apparait dans les journaux de la plateforme et sert a retrouver le site.
# NE DOIT JAMAIS ETRE PREFIXE PAR `NEXT_PUBLIC_` : prefixe en trop, la variable
# reste cote serveur et le bouton flottant n'a plus rien a afficher.
MGS_SITE_KEY=remplir_depuis_la_plateforme

# SECRET DU SITE. Cle de serveur uniquement, jamais NEXT_PUBLIC_, jamais dans un
# composant client, jamais dans un log.
# Consequence d'une fuite : quiconque obtient ce secret se fait passer pour la
# boutique — lecture de l'espace agence, creation de demandes en son nom, et
# consommation du quota de 60 requetes/minute de la boutique. La rotation
# (`npm run site:credential` cote plateforme) invalide l'ancien secret.
MGS_SITE_SECRET=remplir_depuis_la_plateforme

# URL publique du site vitrine de l'agence, affichee dans le credit discret du
# pied de page. Doit commencer par https://.
MGS_WEBSITE_URL=https://www.mindgraphixsolution.com

# Identite de secours de l'agence. Ces trois variables ne servent QUE si la
# plateforme est injoignable : des lors, elles donnent au commercant au moins un
# moyen de contacter son agence. Si la plateforme repond, c'est ELLE qui fait foi
# — ces variables sont alors ignorees, y compris pour dire « pas de coordonnees ».
# Les laisser vides est valide : le site fonctionnera, sans filet de repli.
MGS_AGENCY_NAME=MindGraphixSolution
MGS_AGENCY_WHATSAPP=22600000000
MGS_AGENCY_EMAIL=contact@example.com

# POST /api/agency/request — la demande de prestation — exige-t-elle une session
# connectee ? (facultatif)
# Absente ou `1` : oui, c'est le defaut. Un visiteur anonyme recoit alors «
# Connectez-vous pour envoyer une demande. », et l'email du demandeur est lu
# dans la session, jamais dans le corps de la requete. Seul `0` (comme `false`
# ou `non`) rouvre le formulaire public, et le corps redevient alors la SEULE
# source de l'email : n'ouvrez cette porte que si le site a un formulaire de
# contact voulu.
# Meme variable et meme defaut que dans le connecteur : a garder alignes entre
# les depots clients, qui ont la meme route.
MGS_AGENCY_REQUIRER_SESSION=1

# Duree de mise en cache des lectures de l'agence, en secondes (0 a 300).
# 60 s par defaut : assez court pour qu'une desactivation du bouton flottant
# depuis l'administration apparaisse vite, assez long pour tenir la limite de
# 60 requetes/minute d'une boutique qui rend beaucoup de pages.
# 0 = ne jamais cacher (a eviter en production : la boutique se mettrait
# elle-meme en limite de requetes).
MGS_CACHE_REVALIDATE_S=60

# Version du modele attendue par la plateforme, pour signaler les sites
# perimes dans le tableau de bord. A aligner sur `lib/version.ts`.
MGS_TEMPLATE_VERSION=1.0.0